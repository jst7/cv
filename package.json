    "@parcel/transformer-sass": "^2.16.4",
    "npm-run-all2": "^9.0.4",
    "parcel": "^2.16.4",
    "rimraf": "^6.1.3",
    "sass": "^1.106.1",
    "stylelint": "^17.16.0",
    "stylelint-config-recommended-scss": "^17.0.1"
